# Copy as .env next to docker-compose.yml and fill in.
# docker compose reads it automatically.

# Login for the web UI
AUTH_USER=admin

# Password for the web UI - pick something memorable
AUTH_PASS=change-me

# true = reject URLs that resolve to private/LAN IPs (SSRF protection)
BLOCK_PRIVATE_IPS=false

MAX_CONCURRENT_JOBS=3

# Direct LAN access: http://SERVER:DM_HOST_PORT
DM_HOST_PORT=3000

# --- qBittorrent integration -------------------------------------------------
# Login/password for your qBittorrent WebUI. Adjust QBT_API_URL to the name or
# host of your qBittorrent container. Empty QBT_PASS = tab and speed cap off.
# That client's current DL limit is read every 30 s and applied to our downloads.
QBT_API_URL=http://qbittorrent:8081/api/v2
QBT_USER=admin
QBT_PASS=change-me

# --- ntfy push ---------------------------------------------------------------
# Push notification when a download finishes or fails. Point NTFY_URL at your
# ntfy server (Docker DNS name works on the shared network). If your ntfy
# server requires login, set NTFY_USER/NTFY_PASS (otherwise 401s are logged).
# Empty NTFY_TOPIC = notifications off.
NTFY_URL=http://ntfy
NTFY_TOPIC=downloads
NTFY_USER=admin
NTFY_PASS=change-me
